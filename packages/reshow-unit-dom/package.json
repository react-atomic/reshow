  "dependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/chai": "^5.2.3",
    "@types/node": "^26.6.6",
    "@types/sinon": "^22.0.2",
    "chai": "6.3.0",
    "happy-dom": "^21.0.4",
    "prettier": "3.9.10",
    "prettier-eslint": "17.1.2",
    "prettier-eslint-cli": "9.2.1",
    "reshow-constant": "^0.18.0",
    "sinon": "^22.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.9",
    "typescript": "^7.0.2"
  },
  "exports": {
    "types": "./types/index.d.ts",
    "require": "./build/cjs/index.js",
    "import": "./build/es/index.mjs"
  },
  "types": "./types/index.d.ts",
  "main": "./build/cjs/index.js",
  "module": "./build/es/index.mjs",
  "scripts": {
    "clean": "find ./build ./types -name '*.*' | xargs rm -rf",
    "build:cjs": "BABEL_ENV=cjs babel src -d build/cjs --ignore /**/__tests__ --root-mode upward",
    "build:es": "BABEL_ENV=es babel src -d build/es --out-file-extension .mjs --ignore /**/__tests__ --root-mode upward",
    "build:type": "npx -p typescript tsc src/*.js -declaration --allowSyntheticDefaultImports --lib es2022,dom --allowJs --emitDeclarationOnly --skipLibCheck --declarationDir types",
    "build": "npm run clean && npm run build:cjs && npm run build:es && npm run build:type",
    "test": "bun test",
    "prepublishOnly": "npm run test"
  },
  "files": [
    "types",
    "build",
    "package.json",
    "README.md"
  ],
  "engines": {
    "node": ">=14"
  },
  "resolutions": {
    "glob": "^10.3.0",
    "rimraf": "^4.4.1"
  }
}
