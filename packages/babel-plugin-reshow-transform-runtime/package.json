{
  "name": "babel-plugin-reshow-transform-runtime",
  "version": "0.19.0",
  "description": "Custom path for babel transform-runtime (Babel 7 & 8)",
  "repository": "react-atomic/reshow",
  "keywords": [
    "react",
    "reactjs"
  ],
  "author": "Hill <hill@kimo.com>",
  "license": "ISC",
  "dependencies": {
    "reshow-runtime": "*",
    "resolve": "1.19.0",
    "semver": "5.7.2"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "reshow-unit-dom": "*"
  },
  "main": "./build/cjs/index.js",
  "scripts": {
    "clean": "find ./build -name '*.*' | xargs rm -rf",
    "build:cjs": "BABEL_ENV=cjs babel src -d build/cjs --root-mode upward",
    "build": "npm run clean && npm run build:cjs",
    "mochaFor": "mocha -r global-jsdom/register",
    "mocha": "npm run mochaFor -- 'build/cjs/**/__tests__/*.js'",
    "test": "bun test",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "build",
    "package.json",
    "README.md"
  ]
}
