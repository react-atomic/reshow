{
  "version": "0.19.4",
  "name": "reshow-unit",
  "repository": {
    "type": "git",
    "url": "https://github.com/react-atomic/reshow",
    "directory": "packages/reshow-unit"
  },
  "homepage": "https://github.com/react-atomic/reshow/tree/main/packages/reshow-unit",
  "description": "Reshow Unit Test Pack",
  "keywords": [
    "@testing-library"
  ],
  "author": "Hill <hill@kimo.com>",
  "license": "ISC",
  "dependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "get-object-value": "^0.8.1",
    "get-random-id": "^0.5.0",
    "process": "0.11.10",
    "reshow-build": "^1.19.2",
    "reshow-runtime": "^0.17.15",
    "reshow-unit-dom": "^0.19.2",
    "win-doc": "^0.4.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chai": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "exports": {
    "types": "./types/index.d.ts",
    "require": "./build/cjs/index.js",
    "import": "./build/es/index.mjs"
  },
  "main": "./build/cjs/index.js",
  "module": "./build/es/index.mjs",
  "scripts": {
    "format": "prettier-eslint --write '**/src/**/*.js' '**/ui/**/*.jsx'",
    "clean": "find ./build ./types -name '*.*' | xargs rm -rf",
    "build:cjs": "BABEL_ENV=cjs babel src -d build/cjs --ignore /**/__tests__ --root-mode upward",
    "build:es": "BABEL_ENV=es babel src -d build/es --out-file-extension .mjs --root-mode upward",
    "build:type": "npx -p typescript tsc src/*.js --jsx react-jsx --target es6 --declaration --allowJs --emitDeclarationOnly --skipLibCheck --declarationDir types",
    "build": "npm run clean && npm run build:cjs && npm run build:es && npm run build:type",
    "test": "STRICT_MODE=on bun test",
    "prepublishOnly": "npm run test"
  },
  "types": "./types/index.d.ts",
  "files": [
    "types",
    "build",
    "package.json",
    "README.md"
  ]
}
